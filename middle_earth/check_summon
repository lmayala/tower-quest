#!/bin/bash

DBID=$(( `id -u` + 1000)) # Assuming DBID is derived from the current user's UID

# --- Validation for Elrond's container existence and logs ---
elrond_logs=$(docker-compose logs elrond 2>&1)
if ! echo "$elrond_logs" | grep -q "Summons to the community"; then
    echo "****************************************************************************"
    echo "** Elrond's container did not log 'Summons to the community'. Please check **"
    echo "** your docker-compose.yaml and Elrond's command.                          **"
    echo "****************************************************************************"
    exit 1
fi

# --- Validation for shared volume and timestamp file ---
# Get the source path of the volume mounted by elrond
# This needs to be robust for different Docker volume mount points
# A more reliable way is to exec into the container and check
elrond_container_id=$(docker-compose ps -q elrond)
if [ -z "$elrond_container_id" ]; then
    echo "**************************************************"
    echo "** Elrond container is not running. Please start **"
    echo "** your docker-compose setup.                    **"
    echo "**************************************************"
    exit 1
fi

# Check for the timestamp file inside the elrond container's shared volume
# Assuming the shared volume is mounted at /shared as per the proposed docker-compose.yaml
timestamp_file_path="/shared/call_timestamp.txt"
file_count=$(docker exec "$elrond_container_id" find /shared -maxdepth 1 -type f | wc -l)
if [ "$file_count" -ne 1 ]; then
    echo "************************************************************************"
    echo "** There should be exactly one file in Elrond's shared volume (/shared). **"
    echo "** Please ensure only 'call_timestamp.txt' exists.                      **"
    echo "************************************************************************"
    exit 1
fi

# Try to read the timestamp directly from the container
timestring=$(docker exec "$elrond_container_id" cat "$timestamp_file_path" 2>/dev/null)
if [ -z "$timestring" ]; then
    echo "*****************************************************************************"
    echo "** Could not read the timestamp from 'call_timestamp.txt' in Elrond's       **"
    echo "** shared volume. Please ensure the file is created correctly.             **"
    echo "*****************************************************************************"
    exit 1
fi

# Validate the timestamp content
now=$(date +%s)
let diff=($now - $timestring )/60

if [ "$diff" -lt 0 ]; then
  echo "*********************************************************************************************"
  echo "**  Either Elrond lives in the future or there's something wrong with the timestamp saved  **"
  echo "**         Please try taking down and restarting the container with docker-compose         **"
  echo "**  Remember taking down the container with the flag '-v' to be sure old call is deleted   **"
  echo "*********************************************************************************************"
  exit 1
fi

if [ $diff -gt 10 ]; then
  echo "*************************************************************************************************************"
  echo "** The call seems to be a bit too far in the past, so it would be better to retry summoning the community. **"
  echo "**               Please try taking down and restarting the container with docker-compose                   **"
  echo "**         Remember taking down the container with the flag '-v' to be sure old call is deleted            **"
  echo "*************************************************************************************************************"
  exit 1
fi

echo "**********************************"
echo "** Elrond's call was successful **"
echo "**********************************"
sqlite3 /usr/local/lib/middle_earth/middle_earth.db "PRAGMA foreign_keys = ON; UPDATE stages SET stage_completed = 1 WHERE user_id = $DBID;"
read -n 1 -r -s -p "Press any key to continue..." key
exit 0