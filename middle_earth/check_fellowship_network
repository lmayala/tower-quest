#!/bin/bash

DBID=$(( `id -u` + 1000))

# --- Check if Stage 2 is completed ---
CURRENT_STAGE=`sqlite3 /usr/local/lib/middle_earth/middle_earth.db "SELECT stage_completed FROM stages WHERE user_id = $DBID;"`
if [ "$CURRENT_STAGE" -lt 2 ]; then
    echo "*************************************************************************"
    echo "** Stage 2 (Community Responses) has not been completed yet.           **"
    echo "** Please complete Stage 2 before attempting to validate Stage 3.      **"
    echo "*************************************************************************"
    exit 1
fi


# Check for custom network 'fellowship-network'
if ! docker network inspect fellowship-network &>/dev/null; then
    echo "**********************************************************************************"
    echo "** Custom network 'fellowship-network' not found. Please create and define it.  **"
    echo "**********************************************************************************"
    exit 1
fi

# Check if it's a bridge network (optional, but good practice)
NETWORK_DRIVER=$(docker network inspect fellowship-network --format '{{.Driver}}')
if [ "$NETWORK_DRIVER" != "bridge" ]; then
    echo "**************************************************************************************"
    echo "** Network 'fellowship-network' is not a bridge network. Please ensure it's of type **"
    echo "** 'bridge'.                                                                        **"
    echo "**************************************************************************************"
    exit 1
fi

# Define all expected services
declare -a SERVICES=("elrond" "gandalf" "aragorn" "legolas" "gimli" "boromir" "frodo" "sam" "pippin" "merry" "scout")

# Validate each service is connected to fellowship-network
ALL_CONNECTED=true
for service in "${SERVICES[@]}"; do
    container_name="${service}"
    container_id=$(docker ps -q -f name="$container_name")

    if [ -z "$container_id" ]; then
        echo "*****************************************************************"
        echo "** Service '$service' container ('$container_name') not running. **"
        echo "** Please ensure all services are up and named correctly.      **"
        echo "*****************************************************************"
        ALL_CONNECTED=false
        continue
    fi

    if ! docker inspect "$container_id" --format '{{json .NetworkSettings.Networks}}' | grep -q "fellowship-network"; then
        echo "*************************************************************************************"
        echo "** Service '$service' container is not connected to 'fellowship-network'.            **"
        echo "** Please ensure all services are connected to the custom network in your YAML file. **"
        echo "*************************************************************************************"
        ALL_CONNECTED=false
    else
        echo "Service '$service' is connected to 'fellowship-network'."
    fi
done

if [ "$ALL_CONNECTED" = false ]; then
    echo "********************************************************************************"
    echo "** Not all services are correctly connected to 'fellowship-network'.           **"
    echo "** Please review the errors above and ensure all services are connected.      **"
    echo "********************************************************************************"
    exit 1
fi

# Check Gandalf-Scout communication

echo "Checking Gandalf-Scout communication..."
scout_logs=$(docker logs scout 2>&1)
EXPECTED_GANDALF_RESPONSE="Gandalf received your message" 
GANDALF_IP=$(docker inspect gandalf|grep IPAddress|awk '{print $2}'|tr -d '",')
GANDALF_RESPONSE=$(wget -qO- http://${GANDALF_IP}:8080/)

if [ "$EXPECTED_GANDALF_RESPONSE" != "$GANDALF_RESPONSE" ]; then
    echo "*****************************************************************************************"
    echo "** Gandalf container is not responding properly or answer is not the expected one      **"
    echo "** Please ensure Gandalf's server is running correctly                                 **"
    echo "*****************************************************************************************"
    exit 1
fi

if ! echo "$scout_logs" | grep -q "$EXPECTED_GANDALF_RESPONSE"; then
    echo "*****************************************************************************************"
    echo "** Scout did not log the expected response from Gandalf: '$EXPECTED_GANDALF_RESPONSE'. **"
    echo "** Please ensure Gandalf's server is running correctly and Scout sends/receives the  **"
    echo "** message via 'fellowship-network'.                                                 **"
    echo "*****************************************************************************************"
    exit 1
fi

echo "Gandalf-Scout communication validated."

echo "******************************************************"
echo "** Stage 3 (The Fellowship's First Steps) completed! **"
echo "******************************************************"
sqlite3 /usr/local/lib/middle_earth/middle_earth.db "PRAGMA foreign_keys = ON; UPDATE stages SET stage_completed = 3 WHERE user_id = $DBID;"
read -n 1 -r -s -p "Press any key to continue..." key
welcome
exit 0
