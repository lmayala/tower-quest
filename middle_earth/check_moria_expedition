#!/bin/bash

DBID=$(( `id -u` + 1000))

# --- Check if Stage 3 is completed ---
CURRENT_STAGE=`sqlite3 /usr/local/lib/middle_earth/middle_earth.db "SELECT stage_completed FROM stages WHERE user_id = $DBID;"`
if [ "$CURRENT_STAGE" -lt 3 ]; then
    echo "*************************************************************************"
    echo "** Stage 3 (The Fellowship's First Steps) has not been completed yet.  **"
    echo "** Please complete Stage 3 before attempting to validate Stage 4.      **"
    echo "*************************************************************************"
    exit 1
fi

# Check for docker-compose-stage4.yaml
if [ ! -f docker-compose-stage4.yaml ]; then
    echo "*****************************************************************************"
    echo "** The 'docker-compose-stage4.yaml' file was not found. Please ensure it's **"
    echo "** in the current directory when running 'check_moria_expedition'.         **"
    echo "*****************************************************************************"
    exit 1
fi

# Verify 'torchbearer' service is scaled to at least 3 replicas
echo "Checking 'torchbearer' service scaling..."
torchbearer_replicas=$(docker-compose -f docker-compose-stage4.yaml ps -q torchbearer | wc -l)

if [ "$torchbearer_replicas" -lt 3 ]; then
    echo "*********************************************************************************"
    echo "** The 'torchbearer' service is not scaled to at least 3 replicas.             **"
    echo "** Please ensure you have configured 'deploy.replicas' for the torchbearer     **"
    echo "** service in your docker-compose-stage4.yaml.                                 **"
    echo "*********************************************************************************"
    exit 1
fi
echo "'torchbearer' service scaled to $torchbearer_replicas replicas."

# Check if 'explorer' service is running
echo "Checking 'explorer' service..."
explorer_container_id=$(docker-compose -f docker-compose-stage4.yaml ps -q explorer)
if [ -z "$explorer_container_id" ]; then
    echo "*****************************************************************"
    echo "** The 'explorer' service container is not running.            **"
    echo "** Please ensure you have defined and started the 'explorer'   **"
    echo "** service in your docker-compose-stage4.yaml.                 **"
    echo "*****************************************************************"
    exit 1
fi
echo "'explorer' service is running."

# Check for explorer-torchbearer communication (by checking explorer logs)
echo "Checking explorer-torchbearer communication..."
explorer_logs=$(docker-compose -f docker-compose-stage4.yaml logs explorer 2>&1)

# The explorer should be curling to http://torchbearer:8080, which should return the server's response.
# The response from the python http.server is usually blank or a simple directory listing, which won't appear directly
# in the `curl -s` output. Instead, we should look for evidence that `curl` ran successfully, which might be in the form of `Connection refused` NOT being present,
# or just the presence of the `Torchbearer instance` string from the torchbearer's log (if explorer catches it directly or indirectly).
# A better check is to see if explorer's logs contain output from the `curl` command without error messages.

# Let's look for multiple successful HTTP responses, implying load balancing across different torchbearers.
# The python http.server returns a 200 OK. The output to curl -s would be the HTML content, which is usually blank or a directory listing.
# We can just look for the absence of connection errors and repeated curl attempts.

# Get valid torchbearer names and short IDs
valid_identifiers=$(docker-compose -f docker-compose-stage4.yaml ps torchbearer --format "{{.Name}} {{.ID}}" | tr ' ' '\n' | sort -u)

# Extract identifiers from explorer logs and verify they are valid torchbearers
instances=$(echo "$explorer_logs" | sed -n 's/.*Torchbearer instance \+\([^ ]\+\).*/\1/p' | sort -u | grep -Fxf <(echo "$valid_identifiers") | wc -l)

if [ "$instances" -ne 3 ]; then
    echo "**************************************************************************************"
    echo "** Explorer didn't log correctly the logs for torchbearer instances                 **"
    echo "**************************************************************************************"
    echo "$instances instances found"
    exit 1
fi

# Also ensure different torchbearer hostnames appear in the explorer logs, indicating load balancing.
# This is a bit more complex to parse from generic http.server logs. A simpler check for now
# is to ensure the explorer is making *some* successful requests.

# To verify load balancing, we would ideally check if explorer logs show responses from different torchbearer instances.
# However, the current `python3 -m http.server` doesn't include hostname in its default output. 
# For now, we will rely on checking for multiple successful HTTP responses as a proxy for load balancing, 
# and implicitly assume Docker Compose handles the distribution.

echo "Explorer-torchbearer communication validated."

echo "*******************************************************"
echo "** Stage 4 (The Journey Through Moria) completed!    **"
echo "*******************************************************"
sqlite3 /usr/local/lib/middle_earth/middle_earth.db "PRAGMA foreign_keys = ON; UPDATE stages SET stage_completed = 4 WHERE user_id = $DBID;"
read -n 1 -r -s -p "Press any key to continue..." key
welcome
exit 0
